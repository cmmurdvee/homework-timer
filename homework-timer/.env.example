# Supabase project settings. This may be a project URL or a /rest/v1 URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Set SUPABASE_KEY to a publishable key for the public timer, or use a server-only
# secret key instead. Never use a NEXT_PUBLIC_ prefix for either setting.
SUPABASE_KEY=your-supabase-publishable-key
# SUPABASE_SECRET_KEY=your-supabase-secret-key

# These names must match the table and columns in supabase/schema.sql.
SUPABASE_TIMER_TABLE=timer_app_state
SUPABASE_TASKS_TABLE=tasks
SUPABASE_ID_COLUMN=id
SUPABASE_ACTIVE_TIMER_COLUMN=active_timer
SUPABASE_COMPLETED_TASKS_COLUMN=completed_tasks
SUPABASE_REVISION_COLUMN=revision

# The public SQL policies below allow only this shared row.
SUPABASE_STATE_ID=global
